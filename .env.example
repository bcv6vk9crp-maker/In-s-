# Supabase (Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Adresse email du compte admin d'Ines (celle utilisée pour se connecter à /admin)
ADMIN_EMAIL=ines@example.com

# Resend (envoi des emails). Sans clé, les commandes sont enregistrées mais aucun email ne part.
RESEND_API_KEY=
# Expéditeur des emails. Avant d'avoir un nom de domaine vérifié dans Resend : onboarding@resend.dev
EMAIL_FROM="Ines. B <onboarding@resend.dev>"

# Adresse publique du site (liens dans les emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret partagé avec la tâche planifiée Vercel qui anonymise les commandes de plus d'un an
CRON_SECRET=une-longue-chaine-aleatoire
